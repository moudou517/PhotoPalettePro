<resources xmlns:tools="http://schemas.android.com/tools">
	<!-- 基础主题配置 -->
	<style name="Base.Theme.PhotoPalettePro" parent="Theme.MaterialComponents.DayNight.NoActionBar">
		<item name="colorPrimary">@color/primary_blue</item>
		<item name="colorPrimaryDark">@color/primary_blue_dark</item>
		<item name="colorAccent">@color/accent_green</item>
		
		<!-- 核心：全局指定 PopupMenu 使用我们在 styles.xml 中定义的样式 -->
		<item name="popupMenuStyle">@style/Widget.App.PopupMenu</item>
		<!-- 确保菜单文字也遵循自定义样式 -->
		<item name="android:textAppearanceLargePopupMenu">@style/TextAppearance.App.PopupMenu.Item</item>
	</style>
	
	<style name="Theme.PhotoPalettePro" parent="Base.Theme.PhotoPalettePro">
		<!-- 窗体属性配置[cite: 3] -->
		<item name="android:windowBackground">@color/app_background</item>
		<item name="android:windowLightStatusBar">true</item>
		<item name="android:statusBarColor">@color/card_background</item>
	</style>
</resources>