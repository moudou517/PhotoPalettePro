<?xml version="1.0" encoding="utf-8"?>
<!--
	导出按钮：和主按钮同一套蓝紫渐变，整体深一档。
	两个按钮并排时是「主 / 次」的关系，不是两个一模一样的东西。
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
		android:color="#33FFFFFF">
	<item>
		<shape android:shape="rectangle">
			<gradient
					android:angle="315"
					android:startColor="@color/button_gradient_start_deep"
					android:centerColor="@color/button_gradient_center_deep"
					android:endColor="@color/button_gradient_end_deep" />
			<corners android:radius="25dp" />
		</shape>
	</item>
</ripple>
