<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
			 xmlns:tools="http://schemas.android.com/tools"
			 android:layout_width="match_parent"
			 android:layout_height="match_parent"
			 android:background="@drawable/bg_app_gradient"
			 android:fitsSystemWindows="true"
			 tools:context=".MainActivity">

	<!-- 全屏磨砂背景：导入照片后显示模糊照片，营造 iOS 玻璃氛围 -->
	<ImageView
			android:id="@+id/bgPhotoBackdrop"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:scaleType="centerCrop"
			android:alpha="0.45"
			android:importantForAccessibility="no" />

	<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:orientation="vertical">

		<!-- 顶部悬浮玻璃栏 -->
		<RelativeLayout
				android:layout_width="match_parent"
				android:layout_height="56dp"
				android:layout_marginTop="12dp"
				android:layout_marginHorizontal="12dp"
				android:background="@drawable/bg_glass_bar"
				android:elevation="4dp">
			<TextView
					android:id="@+id/tvAppTitle"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_centerInParent="true"
					android:text="PhotoPalettePro"
					android:textColor="@color/text_main"
					android:textSize="18sp"
					android:textStyle="bold"
					android:clickable="true"
					android:focusable="true" />
		</RelativeLayout>

		<!-- 翻页切换：第 1 页 = 摄影海报，第 2 页 = Zine 明信片 -->
		<androidx.viewpager2.widget.ViewPager2
				android:id="@+id/vpModes"
				android:layout_width="match_parent"
				android:layout_height="0dp"
				android:layout_weight="1" />

		<!-- 翻页指示点 -->
		<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="horizontal"
				android:gravity="center"
				android:paddingTop="10dp"
				android:paddingBottom="6dp">

			<View
					android:id="@+id/dotMode0"
					android:layout_width="8dp"
					android:layout_height="8dp"
					android:background="@drawable/indicator_dot_on" />

			<View
					android:id="@+id/dotMode1"
					android:layout_width="8dp"
					android:layout_height="8dp"
					android:layout_marginStart="8dp"
					android:background="@drawable/indicator_dot_off" />
		</LinearLayout>

		<!-- 底部悬浮玻璃栏（导入 / 保存 为两种模式共用） -->
		<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="horizontal"
				android:padding="16dp"
				android:layout_marginBottom="12dp"
				android:layout_marginHorizontal="12dp"
				android:background="@drawable/bg_glass_bar"
				android:elevation="12dp">

			<Button
					android:id="@+id/btnImport"
					android:layout_width="0dp"
					android:layout_height="52dp"
					android:layout_weight="1"
					android:background="@drawable/btn_primary_rounded"
					android:text="导入"
					android:textColor="@color/white"
					android:textSize="16sp" />

			<View
					android:layout_width="12dp"
					android:layout_height="1dp" />

			<Button
					android:id="@+id/btnExport"
					android:layout_width="0dp"
					android:layout_height="52dp"
					android:layout_weight="1"
					android:background="@drawable/btn_export_rounded"
					android:text="保存到相册"
					android:textColor="@color/white"
					android:textSize="16sp" />
		</LinearLayout>
	</LinearLayout>
</FrameLayout>
