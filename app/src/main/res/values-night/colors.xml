<?xml version="1.0" encoding="utf-8"?>
<resources>
	<!-- ============================================
		夜间模式优化配色方案（Material Design Dark）
		设计思路：高对比度 + 护眼 + 现代感
	============================================ -->
	
	<!-- 背景颜色：清爽深蓝黑（GitHub深色风格） -->
	<color name="app_background">#0D1117</color>
	
	<!-- 卡片表面：深灰蓝色，提供层次感 -->
	<color name="card_background">#161B22</color>
	
	<!-- 主文字色：柔和白色，保护眼睛 -->
	<color name="text_main">#E6EAEF</color>
	
	<!-- 辅助文字色：深灰色，保持可读性 -->
	<color name="text_secondary">#8B949E</color>
	
	<!-- 输入框背景：略浅于卡片，形成视觉层次 -->
	<color name="input_background">#21262D</color>
	
	<!-- 分割线：深蓝灰，微妙而优雅 -->
	<color name="divider_color">#30363D</color>
	
	<!-- ============================================
		扩展颜色定义（提升整体美感）
	============================================ -->
	
	<!-- 卡片边框：提高边界定义度 -->
	<color name="card_border">#30363D</color>
	
	<!-- 按钮悬停效果 -->
	<color name="button_hover">#1f6feb</color>
	
	<!-- 输入框焦点边框色 -->
	<color name="input_focus">#58A6FF</color>
	
	<!-- 文字提示色（hint text） -->
	<color name="hint_text">#6E7681</color>
	
	<!-- 涟漪效果色（ripple） -->
	<color name="ripple_color">#30363D</color>
	
	<!-- 强调色新增（用于特殊UI元素） -->
	<color name="accent_blue">#58A6FF</color>
	<color name="accent_green_dark">#238636</color>
	<color name="status_warning">#D29922</color>
	<color name="status_error">#DA3633</color>
	
	<!-- 微妙分割线（用于卡片内部） -->
	<color name="subtle_divider">#21262D</color>
	
	<!-- ============================================
		iOS 玻璃拟态 (Glassmorphism) 扩展色（夜间）
	============================================ -->
	<!--
		玻璃卡片表面：和日间同一套结构（三段，顶边一档高光），
		只是把"面"换成深色半透明。
	-->
	<color name="glass_card_top">#B8161B22</color>
	<color name="glass_card_mid">#A8161B22</color>
	<color name="glass_card_bottom">#8F161B22</color>
	<!-- 顶部/底部悬浮栏的玻璃表面 -->
	<color name="glass_bar_top">#C4161B22</color>
	<color name="glass_bar_mid">#B4161B22</color>
	<color name="glass_bar_bottom">#A0161B22</color>
	<!-- 玻璃高光描边（夜间用极淡白） -->
	<color name="glass_border">#2EFFFFFF</color>
	<color name="glass_highlight">#33FFFFFF</color>
	<color name="ripple_tint">#3360A5FA</color>
	<!-- 页面柔和渐变背景 -->
	<color name="bg_gradient_start">#0A0D14</color>
	<color name="bg_gradient_mid">#0D1117</color>
	<color name="bg_gradient_end">#0B1220</color>
	
	<!-- 背景色雾：玻璃折射的对象 -->
	<color name="bg_blob_blue">#3D4A7BC8</color>
	<color name="bg_blob_green">#3D2F8F72</color>
	<color name="bg_blob_warm">#3D8A6A3C</color>
	<!-- 液态玻璃的整片白（/黑）玻璃：比卡片底色更透，背景要看得出 -->
	<color name="glass_liquid_tint">#6B161B22</color>
	<color name="button_gradient_start">#4F6BFF</color>
	<color name="button_gradient_center">#5B54F0</color>
	<color name="button_gradient_end">#7A3FE0</color>
	<color name="button_gradient_start_deep">#3B49D8</color>
	<color name="button_gradient_center_deep">#4A3FD0</color>
	<color name="button_gradient_end_deep">#6030BC</color>
	<!-- 页码点的反差描边：压在蓝按钮上也能看出边界 -->
	<color name="indicator_halo">#8CFFFFFF</color>

	<!-- ============================================
		选择弹窗的面板：几乎实底，保证可读性
	============================================ -->
	<color name="popup_panel_top">#F21A2029</color>
	<color name="popup_panel_mid">#ED1A2029</color>
	<color name="popup_panel_bottom">#E81A2029</color>

</resources>








