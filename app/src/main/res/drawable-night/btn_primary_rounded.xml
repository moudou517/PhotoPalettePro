<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
		android:color="#30363D">
	<!-- 夜间模式按钮：描边 + 半透底色 -->
	<item>
		<shape android:shape="rectangle">
			<!-- 极淡黑底色（10% 透明度） -->
			<solid android:color="#0000001A" />
			<corners android:radius="25dp" />
			<!-- 白色描边（20% 透明度，1dp 宽度） -->
			<stroke android:width="1dp" android:color="#FFFFFF33" />
		</shape>
	</item>
</ripple>

